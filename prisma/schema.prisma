// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Visitas a la página (para el panel de admin)
model Visit {
  id        String   @id @default(cuid())
  // Sección vista: inicio, hombre, mujer, categorias
  section   String   @default("inicio")
  // Identificador anónimo del navegador (para no duplicar)
  visitorId String
  // User agent resumido (navegador + SO)
  device    String?
  createdAt DateTime @default(now())

  @@index([section])
  @@index([createdAt])
  @@index([visitorId])
}

// Productos vistos en Quick View
model ProductView {
  id        String   @id @default(cuid())
  productId String
  productName String
  visitorId String
  createdAt DateTime @default(now())

  @@index([productId])
  @@index([createdAt])
}